{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2024",
    "checkJs": false,
    "allowJs": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strict": true,
    "removeComments": true,
    "alwaysStrict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "sourceMap": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "**/node_modules/*"],
  "include": ["src"]
}
