{
  "name": "stemmatic",
  "version": "1.0.0",
  "description": "Turn ChatGPT exports into Markdown, prompt, JSON, and statistics artifacts.",
  "keywords": [
    "chatgpt",
    "openai",
    "chatgpt-export",
    "markdown",
    "cli"
  ],
  "author": "Scover",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5cover/stemmatic.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/5cover/stemmatic/issues"
  },
  "homepage": "https://github.com/5cover/stemmatic#readme",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "stemmatic": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --incremental",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build && node --test test/*.test.mjs",
    "check": "pnpm lint && pnpm test",
    "prepack": "pnpm --filter @stemmatic/core build && pnpm build",
    "prepublishOnly": "pnpm --filter @stemmatic/core test && pnpm test"
  },
  "license": "MIT",
  "dependencies": {
    "@5cover/moremaps": "^1.1.0",
    "@stemmatic/core": "workspace:*",
    "@commander-js/extra-typings": "^14.0.0",
    "commander": "^14.0.2",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sanitize-filename": "^1.6.4",
    "stream-chain": "^3.6.1",
    "stream-json": "^2.1.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.5.0",
    "@types/stream-json": "^1.7.8",
    "typescript": "^6.0.2"
  }
}
