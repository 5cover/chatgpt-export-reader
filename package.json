{
  "name": "chatgpt-export-reader-workspace",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm --filter @chatgpt-export-reader/core build && pnpm --filter chatgpt-export-reader build",
    "build:dashboard": "pnpm --filter @chatgpt-export-reader/dashboard build",
    "build:all": "pnpm build && pnpm build:dashboard",
    "lint": "eslint . --max-warnings 0",
    "publish:check": "pnpm build && pnpm --filter @chatgpt-export-reader/core check && pnpm --filter chatgpt-export-reader check && pnpm --filter @chatgpt-export-reader/core pack --dry-run --json && pnpm --filter chatgpt-export-reader pack --dry-run --json",
    "lint:fix": "pnpm lint --fix",
    "test:lint": "node --test test/lint.test.mjs"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^9.39.5",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "trailingComma": "es5"
  }
}
